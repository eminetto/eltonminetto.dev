.container {
  width: 100%;
}
@media (min-width: 640px) {

  .container {
    max-width: 640px;
  }
}
@media (min-width: 768px) {

  .container {
    max-width: 768px;
  }
}
@media (min-width: 1024px) {

  .container {
    max-width: 1024px;
  }
}
@media (min-width: 1280px) {

  .container {
    max-width: 1280px;
  }
}
@media (min-width: 1536px) {

  .container {
    max-width: 1536px;
  }
}
.container-prose {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
  max-width: 44rem;
}
/* Header */
#site-title {
  text-align: center;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 2.25rem;
  line-height: 2.5rem;
  font-weight: 800;
  letter-spacing: -0.025em;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
@media (min-width: 640px) {

  #site-title {
    text-align: left;
  }
}
:is(:where(.dark) #site-title) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.site-header-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
header nav > ul {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
  -moz-column-gap: 1.5rem;
       column-gap: 1.5rem;
  row-gap: 0.5rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.75rem;
  line-height: 1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.025em;
}
header nav > ul > li {
  display: flex;
  align-items: center;
  line-height: 1;
}
nav a, footer a {
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-weight: 700;
  line-height: 1;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
  text-decoration-line: none;
}
nav a:hover, footer a:hover {
  background-color: rgb(255 212 10 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) nav a),:is(:where(.dark)  footer a) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}
:is(:where(.dark) nav a:hover),:is(:where(.dark)  footer a:hover) {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
/* item ativo: realce amarelo da marca */
nav a.active {
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  --tw-shadow: inset 0 -0.5em 0 #ffd40a;
  --tw-shadow-colored: inset 0 -0.5em 0 var(--tw-shadow-color);
  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);
}
:is(:where(.dark) nav a.active) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.toggle-theme {
  height: 1.5rem;
  width: 1.5rem;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}
.toggle-theme:hover {
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) .toggle-theme) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}
:is(:where(.dark) .toggle-theme:hover) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
/* Links de conteúdo: preto + sublinhado amarelo + hover amarelo */
#content a {
  font-weight: 500;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: underline;
  text-decoration-color: #ffd40a;
  text-decoration-thickness: 2px;
  text-underline-offset: 2px;
}
#content a:hover {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) #content a) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
  text-decoration-color: #ffd40a;
}
:is(:where(.dark) #content a:hover) {
  background-color: rgb(255 212 10 / 0.25);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
/* Títulos de posts (links) — mesmo padrão */
#content .title-small a, #content .title-large a {
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: underline;
  text-decoration-color: #ffd40a;
  text-decoration-thickness: 2px;
  text-underline-offset: 2px;
}
#content .title-small a:hover, #content .title-large a:hover {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) #content .title-small a),:is(:where(.dark)  #content .title-large a) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
  text-decoration-color: #ffd40a;
}
:is(:where(.dark) #content .title-small a:hover),:is(:where(.dark)  #content .title-large a:hover) {
  background-color: rgb(255 212 10 / 0.25);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.title-large {
  text-wrap: balance;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 2.25rem;
  line-height: 2.5rem;
  font-weight: 800;
  line-height: 1.25;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) .title-large) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.title-small {
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 1.5rem;
  line-height: 2rem;
  font-weight: 800;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) .title-small) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.meta {
  margin-top: 0.25rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  -moz-column-gap: 0.5rem;
       column-gap: 0.5rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}
:is(:where(.dark) .meta) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}
.meta a {
  text-decoration-line: none;
}
.date {
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 600;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}
:is(:where(.dark) .date) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}
.description {
  font-size: 1rem;
  line-height: 1.5rem;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}
:is(:where(.dark) .description) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}
#content .read-more {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.025em;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: underline;
  text-decoration-color: #ffd40a;
  text-decoration-thickness: 2px;
  text-underline-offset: 2px;
}
#content .read-more:hover {
  gap: 0.5rem;
  background-color: rgb(255 212 10 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) #content .read-more) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
  text-decoration-color: #ffd40a;
}
:is(:where(.dark) #content .read-more:hover) {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
/* TOC */
.table-of-contents {
  border-radius: 0.5rem;
  border-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(243 239 232 / var(--tw-bg-opacity));
  padding: 1rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) .table-of-contents) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(34 29 22 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
.table-of-contents #TableOfContents ul {
  margin-left: 1rem;
  list-style-type: decimal;
}
.table-of-contents #TableOfContents li {
  margin-top: 0.25rem;
  margin-bottom: 0.25rem;
  font-size: 1rem;
  line-height: 1.5rem;
}
.table-of-contents #TableOfContents a {
  font-weight: 400;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: underline;
  text-decoration-color: #ffd40a;
  text-decoration-thickness: 2px;
  text-underline-offset: 2px;
}
.table-of-contents #TableOfContents a:hover {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
:is(:where(.dark) .table-of-contents #TableOfContents a) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
  text-decoration-color: #ffd40a;
}
:is(:where(.dark) .table-of-contents #TableOfContents a:hover) {
  background-color: rgb(255 212 10 / 0.25);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
/* Paginação */
.pagination-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border-radius: 0.375rem;
  border-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(243 239 232 / var(--tw-bg-opacity));
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  font-weight: 600;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: none;
}
.pagination-button:hover {
  --tw-border-opacity: 1;
  border-color: rgb(255 212 10 / var(--tw-border-opacity));
  background-color: rgb(255 212 10 / 0.2);
}
:is(:where(.dark) .pagination-button) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(34 29 22 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
:is(:where(.dark) .pagination-button:hover) {
  --tw-border-opacity: 1;
  border-color: rgb(255 212 10 / var(--tw-border-opacity));
}
/* Taxonomias */
.taxonomy-list {
  margin-left: 0px;
  display: flex;
  list-style-type: none;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.taxonomy-list a {
  border-radius: 9999px;
  --tw-bg-opacity: 1;
  background-color: rgb(243 239 232 / var(--tw-bg-opacity));
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.375rem;
  padding-bottom: 0.375rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 1rem;
  line-height: 1.5rem;
  font-weight: 500;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: none;
}
.taxonomy-list a:hover {
  --tw-bg-opacity: 1;
  background-color: rgb(255 212 10 / var(--tw-bg-opacity));
}
:is(:where(.dark) .taxonomy-list a) {
  --tw-bg-opacity: 1;
  background-color: rgb(34 29 22 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}
:is(:where(.dark) .taxonomy-list a:hover) {
  --tw-bg-opacity: 1;
  background-color: rgb(255 212 10 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
/* Botão "copiar" → estilos em CSS puro abaixo (fora do @layer)
     porque a classe é adicionada via JS e seria removida pelo tree-shaking
     do Tailwind se ficasse dentro de @layer components. */
/* Alert shortcode */
.alert-box {
  margin-bottom: 1.25rem;
  border-radius: 0.375rem;
  border-left-width: 4px;
  padding-left: 1rem;
  padding-right: 1rem;
  padding-top: 0.75rem;
  padding-bottom: 0.75rem;
}
.alert-box.info {
  --tw-border-opacity: 1;
  border-color: rgb(59 130 246 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(239 246 255 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(30 58 138 / var(--tw-text-opacity));
}
:is(:where(.dark) .alert-box.info) {
  background-color: rgb(23 37 84 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(191 219 254 / var(--tw-text-opacity));
}
.alert-box.warning {
  --tw-border-opacity: 1;
  border-color: rgb(234 179 8 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(254 252 232 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(113 63 18 / var(--tw-text-opacity));
}
:is(:where(.dark) .alert-box.warning) {
  background-color: rgb(66 32 6 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(254 240 138 / var(--tw-text-opacity));
}
.alert-box.success {
  --tw-border-opacity: 1;
  border-color: rgb(34 197 94 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(240 253 244 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(20 83 45 / var(--tw-text-opacity));
}
:is(:where(.dark) .alert-box.success) {
  background-color: rgb(5 46 22 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(187 247 208 / var(--tw-text-opacity));
}
.alert-box.error {
  --tw-border-opacity: 1;
  border-color: rgb(239 68 68 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(254 242 242 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(127 29 29 / var(--tw-text-opacity));
}
:is(:where(.dark) .alert-box.error) {
  background-color: rgb(69 10 10 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(254 202 202 / var(--tw-text-opacity));
}
