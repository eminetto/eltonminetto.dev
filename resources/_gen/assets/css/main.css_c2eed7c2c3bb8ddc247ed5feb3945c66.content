/* GenericUnderline */ .dark .chroma .gl { text-decoration:underline } .hover\:text-gray-900:hover {
  --tw-text-opacity: 1;
  color: rgb(17 24 39 / var(--tw-text-opacity));
} .hover\:underline:hover {
  text-decoration-line: underline;
} .hover\:no-underline:hover {
  text-decoration-line: none;
} .focus\:border-gray-500:focus {
  --tw-border-opacity: 1;
  border-color: rgb(107 114 128 / var(--tw-border-opacity));
} @media (min-width: 640px) {

  .sm\:order-1 {
    order: 1;
  }

  .sm\:order-2 {
    order: 2;
  }

  .sm\:flex-row {
    flex-direction: row;
  }

  .sm\:justify-end {
    justify-content: flex-end;
  }

  .sm\:gap-10 {
    gap: 2.5rem;
  }

  .sm\:px-8 {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .sm\:text-left {
    text-align: left;
  }
} @media (min-width: 768px) {

  .md\:px-0 {
    padding-left: 0px;
    padding-right: 0px;
  }
} @media (min-width: 1024px) {

  .lg\:inline-block {
    display: inline-block;
  }

  .lg\:hidden {
    display: none;
  }

  .lg\:px-0 {
    padding-left: 0px;
    padding-right: 0px;
  }
} :is(:where(.dark) .dark\:block) {
  display: block;
} :is(:where(.dark) .dark\:hidden) {
  display: none;
} :is(:where(.dark) .dark\:border-gray-700) {
  --tw-border-opacity: 1;
  border-color: rgb(55 65 81 / var(--tw-border-opacity));
} :is(:where(.dark) .dark\:bg-gray-900) {
  --tw-bg-opacity: 1;
  background-color: rgb(17 24 39 / var(--tw-bg-opacity));
} :is(:where(.dark) .dark\:text-gray-300) {
  --tw-text-opacity: 1;
  color: rgb(209 213 219 / var(--tw-text-opacity));
} :is(:where(.dark) .dark\:text-gray-400) {
  --tw-text-opacity: 1;
  color: rgb(156 163 175 / var(--tw-text-opacity));
} :is(:where(.dark) .dark\:text-gray-500) {
  --tw-text-opacity: 1;
  color: rgb(107 114 128 / var(--tw-text-opacity));
} :is(:where(.dark) .dark\:hover\:text-gray-100:hover) {
  --tw-text-opacity: 1;
  color: rgb(243 244 246 / var(--tw-text-opacity));
} :is(:where(.dark) .dark\:focus\:border-gray-400:focus) {
  --tw-border-opacity: 1;
  border-color: rgb(156 163 175 / var(--tw-border-opacity));
}
