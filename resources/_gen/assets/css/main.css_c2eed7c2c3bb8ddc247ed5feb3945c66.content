/* LiteralStringOther */ .dark .chroma .sx { color:#f1fa8c }
/* LiteralStringRegex */ .dark .chroma .sr { color:#f1fa8c }
/* LiteralStringSingle */ .dark .chroma .s1 { color:#f1fa8c }
/* LiteralStringSymbol */ .dark .chroma .ss { color:#f1fa8c }
/* LiteralNumber */ .dark .chroma .m { color:#bd93f9 }
/* LiteralNumberBin */ .dark .chroma .mb { color:#bd93f9 }
/* LiteralNumberFloat */ .dark .chroma .mf { color:#bd93f9 }
