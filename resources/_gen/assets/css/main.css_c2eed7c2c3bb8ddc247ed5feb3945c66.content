/* LineNumbers */ .dark .chroma .ln { white-space:pre;-webkit-user-select:none;-moz-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f }
/* Line */ .dark .chroma .line { display:flex; }
