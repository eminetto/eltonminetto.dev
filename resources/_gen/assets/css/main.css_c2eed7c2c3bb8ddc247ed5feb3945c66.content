/* NameVariableGlobal */ .dark .chroma .vg { color:#8be9fd;font-style:italic }
/* NameVariableInstance */ .dark .chroma .vi { color:#8be9fd;font-style:italic }
/* NameVariableMagic */ .dark .chroma .vm { color:#8be9fd;font-style:italic }
/* NameFunction */ .dark .chroma .nf { color:#50fa7b }
/* NameFunctionMagic */ .dark .chroma .fm { color:#50fa7b }
/* LiteralString */ .dark .chroma .s { color:#f1fa8c }
/* LiteralStringAffix */ .dark .chroma .sa { color:#f1fa8c }
/* LiteralStringBacktick */ .dark .chroma .sb { color:#f1fa8c }
/* LiteralStringChar */ .dark .chroma .sc { color:#f1fa8c }
/* LiteralStringDelimiter */ .dark .chroma .dl { color:#f1fa8c }
/* LiteralStringDoc */ .dark .chroma .sd { color:#f1fa8c }
