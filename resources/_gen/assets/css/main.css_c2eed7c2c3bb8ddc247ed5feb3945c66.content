  display: none;
}
  /* ---- Base ---- */
  body {
  --tw-bg-opacity: 1;
  background-color: rgb(250 248 244 / var(--tw-bg-opacity));
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 1.125rem;
  line-height: 1.75rem;
  line-height: 1.625;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
  :is(:where(.dark) body) {
  --tw-bg-opacity: 1;
  background-color: rgb(23 20 15 / var(--tw-bg-opacity));
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}

  h1, h2, h3, h4, h5, h6 {
  margin-bottom: 1rem;
  margin-top: 2rem;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-weight: 800;
  letter-spacing: -0.025em;
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}

  h1:first-child, h2:first-child, h3:first-child, h4:first-child, h5:first-child, h6:first-child {
  margin-top: 0px;
}

  :is(:where(.dark) h1),:is(:where(.dark)  h2),:is(:where(.dark)  h3),:is(:where(.dark)  h4),:is(:where(.dark)  h5),:is(:where(.dark)  h6) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}

  h1, h2, h3, h4, h5, h6 {
    scroll-margin-top: 1.5rem;
  }
  h1 {
  font-size: 2.25rem;
  line-height: 2.5rem;
  line-height: 1.25;
}
  h2 {
  font-size: 1.875rem;
  line-height: 2.25rem;
  line-height: 1.25;
}
  h3 {
  font-size: 1.5rem;
  line-height: 2rem;
}
  h4 {
  font-size: 1.25rem;
  line-height: 1.75rem;
}
  h5 {
  font-size: 1.125rem;
  line-height: 1.75rem;
}
  h6 {
  font-size: 1rem;
  line-height: 1.5rem;
}

  p, ul, ol, dl, blockquote, pre, table, figure {
  margin-bottom: 1.25rem;
}

  /* Estilo único de link: preto + sublinhado amarelo + hover amarelo */
  a {
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
  text-decoration-line: underline;
  text-decoration-color: #ffd40a;
  text-decoration-thickness: 2px;
  text-underline-offset: 2px;
}
  a:hover {
  background-color: rgb(255 212 10 / 0.4);
  --tw-text-opacity: 1;
  color: rgb(20 20 20 / var(--tw-text-opacity));
}
  :is(:where(.dark) a) {
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
  text-decoration-color: #ffd40a;
}
  :is(:where(.dark) a:hover) {
  background-color: rgb(255 212 10 / 0.3);
  --tw-text-opacity: 1;
  color: rgb(236 231 223 / var(--tw-text-opacity));
}

  hr {
  margin-top: 2rem;
  margin-bottom: 2rem;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
}

  :is(:where(.dark) hr) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
}

  blockquote {
  border-left-width: 4px;
  --tw-border-opacity: 1;
  border-color: rgb(255 212 10 / var(--tw-border-opacity));
  padding-left: 1rem;
  font-style: italic;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}

  :is(:where(.dark) blockquote) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}

  ul, ol {
  margin-left: 1.5rem;
}
  ol {
  list-style-type: decimal;
}
  ul {
  list-style-type: disc;
}
  li + li {
  margin-top: 0.25rem;
}
  nav ul, footer ul {
  margin-left: 0px;
  list-style-type: none;
}

  /* Código inline */
  code {
  border-radius: 0.25rem;
  border-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(243 239 232 / var(--tw-bg-opacity));
  padding-left: 0.375rem;
  padding-right: 0.375rem;
  padding-top: 0.125rem;
  padding-bottom: 0.125rem;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.85em;
}
  :is(:where(.dark) code) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(34 29 22 / var(--tw-bg-opacity));
}
  /* Blocos de código (Chroma) */
  pre {
  overflow-x: auto;
  border-radius: 0.5rem;
  border-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  padding: 1rem;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 0.875rem;
  line-height: 1.25rem;
  line-height: 1.625;
}
  :is(:where(.dark) pre) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
}
  pre code {
  border-width: 0px;
  background-color: transparent;
  padding: 0px;
  font-size: 0.95em;
}

  figure {
  margin-left: auto;
  margin-right: auto;
}
  figcaption {
  margin-top: 0.5rem;
  text-align: center;
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 0.875rem;
  line-height: 1.25rem;
  --tw-text-opacity: 1;
  color: rgb(77 77 77 / var(--tw-text-opacity));
}
  :is(:where(.dark) figcaption) {
  --tw-text-opacity: 1;
  color: rgb(163 157 146 / var(--tw-text-opacity));
}

  table {
  width: 100%;
  border-collapse: separate;
  --tw-border-spacing-x: 0px;
  --tw-border-spacing-y: 0px;
  border-spacing: var(--tw-border-spacing-x) var(--tw-border-spacing-y);
  border-radius: 0.375rem;
  border-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  font-family: "Archivo", -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  font-size: 1rem;
  line-height: 1.5rem;
}

  :is(:where(.dark) table) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
}
  thead th {
  border-bottom-width: 1px;
  border-right-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(243 239 232 / var(--tw-bg-opacity));
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  text-align: left;
}
  thead th:last-child {
  border-right-width: 0px;
}
  :is(:where(.dark) thead th) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
  --tw-bg-opacity: 1;
  background-color: rgb(34 29 22 / var(--tw-bg-opacity));
}
  tbody td {
  border-bottom-width: 1px;
  border-right-width: 1px;
  --tw-border-opacity: 1;
  border-color: rgb(232 225 212 / var(--tw-border-opacity));
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}
  tbody td:last-child {
  border-right-width: 0px;
}
  :is(:where(.dark) tbody td) {
  --tw-border-opacity: 1;
  border-color: rgb(50 43 34 / var(--tw-border-opacity));
}
  tbody tr:last-child td {
  border-bottom-width: 0px;
}

  img {
  margin-left: auto;
  margin-right: auto;
  border-radius: 0.5rem;
}

